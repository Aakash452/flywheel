# Postgres connection string used by drizzle-kit and the app.
# Requires the pgvector extension available on the server (creatives.embedding).
DATABASE_URL=postgres://flywheel:flywheel@localhost:5432/flywheel

# Redis connection for BullMQ.
REDIS_URL=redis://localhost:6379

# Anthropic API key. claude-sonnet-4-6 is used for interactive generation;
# the batch API is used for sourcing relevance scoring and other
# non-interactive generation (see Cost control in the build spec).
ANTHROPIC_API_KEY=

# Daily hard cap on Claude API spend, in cents. When exceeded, the job queue
# pauses generation jobs and alerts the operator. See src/services/cost-control.
DAILY_API_SPEND_CAP_CENTS=5000

# Dashboard (src/app/). Recorded as the approver on every approval made
# through the dashboard — there's no login system, so this identifies the
# one operator. Put the dashboard behind network-level access control
# (localhost/VPN/auth proxy); it has no auth of its own.
OPERATOR_EMAIL=operator@example.com

# Beehiiv API (subscriber sync, send).
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
# Optional: override the API base URL (Beehiiv sandbox, or a local stub
# server for smoke-testing the worker without hitting the real API).
# BEEHIIV_API_BASE_URL=https://api.beehiiv.com/v2

# Meta Marketing API (creatives are always created paused; see Human gates).
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Sourcing pipeline.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires a descriptive User-Agent identifying the app + a contact.
REDDIT_USER_AGENT=flywheel-sourcing/0.1 (contact: you@example.com)

# Embedding provider for semantic dedup (sourcing) and creative-variant
# diversity (Creative Engine). Not in the original integrations list — see
# the deviation note on creatives.embedding in src/db/schema.ts. Sourcing's
# semantic dedup is skipped (URL dedup only) if this is unset.
VOYAGE_API_KEY=
# Placeholder rate, not independently verified — see src/config/pricing.ts.
VOYAGE_ESTIMATED_COST_CENTS_PER_MILLION_TOKENS=2
