# Loaded automatically by vitest.config.ts for `npm test`. Copy to
# .env.test and point it at a database that is NOT your dev/real database —
# tests assume they own every row in every table.
#
# Setup (same Postgres instance as your main DATABASE_URL, separate DB):
#   psql -d postgres -c "CREATE DATABASE flywheel_test OWNER flywheel;"
#   DATABASE_URL=postgres://flywheel:flywheel@localhost:5432/flywheel_test npm run db:migrate
DATABASE_URL=postgres://flywheel:flywheel@localhost:5432/flywheel_test
